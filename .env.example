# Shared app configuration
APP_ENV=development
DATABASE_URL=sqlite:///./nusaflow.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Read by frontend/next.config.mjs (server-side only, never sent to the
# browser) to build the /api/* rewrite target. In production, point this
# at your deployed backend URL instead of localhost.
BACKEND_URL=http://localhost:8000

# Cache TTL (seconds) used by backend inventory demand cache. Default: 300
CACHE_TTL=300

# ADMIN_API_KEY is required for admin endpoints (e.g., cache flush, demo reset). Set to a strong secret in production.
ADMIN_API_KEY="test-admin-token"

# Signs/verifies login JWTs (see backend/app/auth.py). The app refuses to
# start with the placeholder value below when APP_ENV isn't "development" —
# generate a real one for anything else, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev-only-insecure-secret-change-me"
