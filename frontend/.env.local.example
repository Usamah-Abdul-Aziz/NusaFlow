# Next.js only auto-loads env files from inside frontend/, not the repo
# root .env (that one is for the backend only, via app/config.py).
#
# Copy this to frontend/.env.local if you need to point the /api/* rewrite
# (see next.config.mjs) at a backend that isn't on localhost:8000 — e.g.
# a different local port, or later, before deploying, your real backend URL.

BACKEND_URL=http://localhost:8000
